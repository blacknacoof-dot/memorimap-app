# Supabase Configuration
VITE_SUPABASE_URL=YOUR_SUPABASE_URL
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Maps
VITE_NAVER_MAP_CLIENT_ID=YOUR_NAVER_MAP_CLIENT_ID
VITE_KAKAO_REST_API_KEY=YOUR_KAKAO_REST_API_KEY
NAVER_CLIENT_ID=YOUR_NAVER_CLIENT_ID
NAVER_CLIENT_SECRET=YOUR_NAVER_CLIENT_SECRET

# AI (서버사이드 전용 - Edge Function에서 사용, VITE_ 접두사 없음)
# GOOGLE_GENAI_API_KEY=YOUR_GOOGLE_GENAI_API_KEY

# Payment (PortOne - public keys, VITE_ OK)
VITE_PORTONE_STORE_ID=YOUR_PORTONE_STORE_ID
VITE_PORTONE_CHANNEL_KEY=YOUR_PORTONE_CHANNEL_KEY
VITE_PORTONE_BILLING_CHANNEL_KEY=YOUR_PORTONE_BILLING_CHANNEL_KEY
VITE_ENABLE_RECURRING_SUBSCRIPTIONS=false

# Server-only (DO NOT prefix with VITE_)
# SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
# PORTONE_API_SECRET=YOUR_PORTONE_API_SECRET

# Supabase Edge Function Secrets (set in Supabase Dashboard → Edge Functions → Secrets)
# These are NOT VITE_ prefixed - they are server-side only
# SUPER_ADMIN_EMAIL=          # Required: Email of super admin for approve-partner function
# RESEND_API_KEY=             # Required: Resend API key for email notifications

# Instructions:
# 1. Copy this file as .env.local
# 2. Replace all YOUR_* values with actual credentials
# 3. Get Supabase keys from: https://supabase.com/dashboard/project/_/settings/api
# 4. NEVER commit .env.local to git
